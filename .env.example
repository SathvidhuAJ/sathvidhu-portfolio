# Server-only. Configure these in Vercel, never under public/.
# Leave disabled until the domain, credentials and rate limiter are ready.
CONTACT_ENABLED=false
RESEND_API_KEY=replace_with_resend_sending_key
CONTACT_FROM_EMAIL=portfolio@your-verified-domain.example
CONTACT_ALLOWED_ORIGINS=https://your-portfolio.vercel.app
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace_with_upstash_token
CONTACT_RATE_LIMIT_SALT=replace_with_at_least_32_random_characters
